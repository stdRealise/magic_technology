script/source = "using Godot;
using System;

public partial class Fragments : Node3D
{
	private double _lifeTime = 10;
	public override void _Ready()
	{
	}

	public override void _PhysicsProcess(double delta)
	{
		_lifeTime -= delta;
		if (_lifeTime < 0)
			QueueFree();
	}
}
"

